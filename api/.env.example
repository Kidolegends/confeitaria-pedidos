# =============================================================
#  Doce Encanto Confeitaria - variáveis de ambiente da API
#  Copie para .env (npm run setup já faz isso) e ajuste.
# =============================================================

# ---------- Geral ----------
NODE_ENV=development
PORT=3333
# Endereço público do site (usado nos links de acompanhamento enviados ao cliente).
# Em desenvolvimento é o Vite (5173). Em produção: https://seudominio.com.br
PUBLIC_URL="http://localhost:5173"
# Fuso horário da confeitaria (Uberaba-MG = horário de Brasília)
BUSINESS_UTC_OFFSET="-03:00"

# ---------- Banco de dados ----------
# SQLite (padrão, arquivo dentro de api/prisma/):
DATABASE_URL="file:./dev.db"
# PostgreSQL (Neon, Supabase, Render, Railway...): basta trocar a URL.
# DATABASE_URL="postgresql://usuario:senha@host:5432/confeitaria?sslmode=require"
# (opcional) força o provedor: sqlite | postgresql. Se vazio, é detectado pela URL.
DB_PROVIDER=

# ---------- Login do painel ----------
# Em produção use um valor aleatório com 32+ caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-este-segredo-por-um-valor-longo"
JWT_EXPIRES_IN="8h"
# Primeiro acesso em produção: se o banco não tiver nenhum usuário, este admin é criado.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Segurança HTTP ----------
# Domínios extras que podem chamar a API (separados por vírgula). Vazio = só o próprio site.
CORS_ORIGIN=
# 1 quando roda atrás de proxy (Render, Railway, Nginx) para o limite por IP funcionar.
TRUST_PROXY=0
# Máximo de pedidos e de tentativas de login por IP a cada 15 minutos
RATE_LIMIT_ORDERS=10
RATE_LIMIT_LOGIN=10

# ---------- Fotos dos produtos ----------
# local = salva em disco (UPLOAD_DIR). s3 = qualquer storage compatível com S3 (Cloudflare R2, AWS S3, Backblaze B2).
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública do bucket, ex.: https://fotos.seudominio.com.br
S3_PUBLIC_URL=

# ---------- Aviso de novo pedido para a dona ----------
# none = desligado (o cliente envia pelo botão do WhatsApp)
# log = só escreve no log do servidor
# whatsapp_cloud = envia mensagem pela API oficial do WhatsApp (Meta)
NOTIFY_PROVIDER=none
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v21.0
# Nome do modelo aprovado na Meta (recomendado). Vazio = mensagem de texto simples.
WHATSAPP_CLOUD_TEMPLATE=
WHATSAPP_CLOUD_TEMPLATE_LANG=pt_BR

# ---------- Seed (dados de exemplo) ----------
# Número FICTÍCIO usado pelo seed. O número real é configurado no painel (Configurações).
WHATSAPP_NUMBER="5534900000000"
# O seed apaga tudo. Em produção ele só roda se isto for true.
SEED_ALLOW_PRODUCTION=false
